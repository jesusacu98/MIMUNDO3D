# Plantilla de variables de entorno — sólo nombres, sin valores reales.
# Los valores de verdad van en .env (fuera de git, ver .gitignore).
# Al agregar una variable nueva, agrégala aquí también (sin valor) para que quede documentada.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# El chat de ideas (/ideas) NO se configura aquí — proveedor de IA, modelo, límites de uso y la
# propia llave de Anthropic se administran desde /admin/ideas/configuracion (tabla `idea_settings`
# en Supabase). Ver ARQUITECTURA.md §12.
